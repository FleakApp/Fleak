# Configuration for private @fleak-org packages
# Configured for GitHub Packages (most common setup)

# Point @fleak-org scope to GitHub Packages
@fleak-org:registry=https://npm.pkg.github.com

# Authenticate with GitHub Packages using token from environment variable
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
always-auth=true

# Note: You need to set GITHUB_TOKEN environment variable:
# - Locally: export GITHUB_TOKEN=your_token (or $env:GITHUB_TOKEN in PowerShell)
# - On Vercel: Add GITHUB_TOKEN in Project Settings > Environment Variables
# 
# To create a GitHub token:
# 1. Go to https://github.com/settings/tokens
# 2. Generate new token (classic) with "read:packages" permission
# 3. Copy the token and use it as GITHUB_TOKEN value

